# Perfil MEDIUM (multimodelo, padrão): camada de dados = 4 CPUs / 8 GB.
# Equivale ao perfil medium da branch heterogeneous-approach (Mongo + Neo4j = 4 CPUs / 8 GB no total).
# Uso: docker compose --env-file .env --env-file limits/medium.env up -d --build

API_CPUS=4
API_MEM=4g

ARANGODB_CPUS=4
ARANGODB_MEM=8g
# 8 GiB em bytes (deve coincidir com ARANGODB_MEM)
ARANGODB_TOTAL_MEMORY_BYTES=8589934592
