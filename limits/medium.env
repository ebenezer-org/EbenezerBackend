# Perfil MEDIUM (heterogêneo, padrão): camada de dados = 4 CPUs / 8 GB no total.
# Equivale ao perfil medium da branch multimodel-approach (ArangoDB 4 CPUs / 8 GB).
# CPU: 1,5 para MongoDB e 2,5 para Neo4j (37,5% e 62,5%); memória: 3 GB e 5 GB (37,5% e 62,5%). Heap e page cache do Neo4j: 2 GB cada.
# Uso: docker compose --env-file .env --env-file limits/medium.env up -d --build

API_CPUS=4
API_MEM=4g

MONGODB_CPUS=2
MONGODB_MEM=3g

NEO4J_CPUS=2
NEO4J_MEM=5g
NEO4J_HEAP=2g
NEO4J_PAGECACHE=2g
