# Perfil MEDIUM (heterogêneo, padrão): camada de dados = 4 CPUs / 8 GB no total.
# Equivale ao perfil medium da branch multimodel-approach (ArangoDB 4 CPUs / 8 GB).
# CPU dividida 50/50 entre Mongo e Neo4j; memória ~40/60 (o Neo4j precisa de heap + page cache).
# Uso: docker compose --env-file .env --env-file limits/medium.env up -d --build

API_CPUS=4
API_MEM=4g

MONGODB_CPUS=2
MONGODB_MEM=3g

NEO4J_CPUS=2
NEO4J_MEM=5g
NEO4J_HEAP=2g
NEO4J_PAGECACHE=2g
