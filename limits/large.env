# Perfil LARGE (heterogêneo): camada de dados = 8 CPUs / 16 GB no total.
# Equivale ao perfil large da branch multimodel-approach (ArangoDB 8 CPUs / 16 GB).
# CPU dividida 50/50 entre Mongo e Neo4j; memória ~40/60 (o Neo4j precisa de heap + page cache).
# Soma de CPUs com a API: 12. O hospedeiro precisa de folga para o gerador de carga.
# Uso: docker compose --env-file .env --env-file limits/large.env up -d --build

API_CPUS=4
API_MEM=4g

MONGODB_CPUS=4
MONGODB_MEM=6g

NEO4J_CPUS=4
NEO4J_MEM=10g
NEO4J_HEAP=4g
NEO4J_PAGECACHE=4g
