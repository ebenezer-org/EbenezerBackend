# Perfil LARGE (multimodelo): camada de dados = 8 CPUs / 16 GB.
# Equivale ao perfil large da branch heterogeneous-approach (Mongo + Neo4j = 8 CPUs / 16 GB no total).
# Soma de CPUs com a API: 12. O hospedeiro precisa de folga para o gerador de carga.
# Uso: docker compose --env-file .env --env-file limits/large.env up -d --build

API_CPUS=4
API_MEM=4g

ARANGODB_CPUS=8
ARANGODB_MEM=16g
# 16 GiB em bytes (deve coincidir com ARANGODB_MEM)
ARANGODB_TOTAL_MEMORY_BYTES=17179869184
