# Perfil SMALL (multimodelo): camada de dados = 2 CPUs / 4 GB.
# Equivale ao perfil small da branch heterogeneous-approach (Mongo + Neo4j = 2 CPUs / 4 GB no total).
# Uso: docker compose --env-file .env --env-file limits/small.env up -d --build

API_CPUS=4
API_MEM=4g

ARANGODB_CPUS=2
ARANGODB_MEM=4g
# 4 GiB em bytes (deve coincidir com ARANGODB_MEM)
ARANGODB_TOTAL_MEMORY_BYTES=4294967296
