# Perfil SMALL (heterogêneo) — Redistribuído: 2 CPUs / 4096 MiB (4 GiB) totais, sem swap
# Mantém equivalência exata de orçamento com o perfil small (ArangoDB 2 CPUs / 4 GiB).

API_CPUS=4
API_MEM=4g

MONGODB_CPUS=0.5
MONGODB_MEM=1024m

NEO4J_CPUS=1.5
NEO4J_MEM=3072m
NEO4J_HEAP=1280m
NEO4J_PAGECACHE=1152m