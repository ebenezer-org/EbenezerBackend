# Perfil SMALL (heterogêneo): camada de dados = 2 CPUs / 4 GB no total.
# Equivale ao perfil small da branch multimodel-approach (ArangoDB 2 CPUs / 4 GB).
# CPU dividida 50/50 entre Mongo e Neo4j; memória ~40/60 (o Neo4j precisa de heap + page cache).
# Uso: docker compose --env-file .env --env-file limits/small.env up -d --build

API_CPUS=4
API_MEM=4g

MONGODB_CPUS=1
MONGODB_MEM=1500m

NEO4J_CPUS=1
NEO4J_MEM=2500m
NEO4J_HEAP=1g
NEO4J_PAGECACHE=1g
